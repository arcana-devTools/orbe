<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mão do Orbe"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Abre o app pelo nome e lê a tela da frente. Não lê senha, login nem captcha. Não mexe no que está escondido." />
        <EditText
            android:id="@+id/token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cola o token ou a linha inteira do comando"
            android:inputType="textNoSuggestions"
            android:paddingTop="16dp" />
        <Button
            android:id="@+id/ligar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ligar a mão" />
        <Button
            android:id="@+id/acesso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ligar leitura da tela" />
        <Button
            android:id="@+id/sobre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aparecer sobre outros apps" />
        <Button
            android:id="@+id/bateria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Não deixar o Android matar a mão" />
        <TextView
            android:id="@+id/estado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="Parada." />
    </LinearLayout>
</ScrollView>
