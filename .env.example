# ============ ORBE — copie para .env e ajuste ============

# --- Servidor / painel -----------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Defina um token se for expor na internet (VPS). Vazio = painel aberto.
AUTH_TOKEN=

# --- Navegador -------------------------------------------------------------
# No seu PC, para VER a janela e logar nas contas:  HEADLESS=0 CHANNEL=chrome
# Num VPS: HEADLESS=1 e CHANNEL vazio (usa o Chromium do Playwright).
HEADLESS=1
CHANNEL=
# Pasta onde ficam os perfis de Chrome (um por conta). Não apague: suas sessões moram aqui.
USER_DATA_DIR=./data/chrome-profiles
DOWNLOADS_DIR=./data/downloads
# Proxy opcional (ex.: http://user:senha@host:3128) — útil para separar contas
PROXY=
STEALTH=1

# --- Cérebro (opcional, mas recomendado) ----------------------------------
# Sem chave, o Orbe funciona em "modo local" (regras + fan-out).
# Com chave, ele PLANEJA de verdade (divide a tarefa entre as IAs) e CONSOLIDA
# as respostas em uma só. Qualquer endpoint compatível com OpenAI serve.
LLM_API_KEY=
LLM_BASE_URL=https://api.openrouter.ai/v1
LLM_MODEL=openai/gpt-4o-mini
# Alternativas:
#   Groq     -> LLM_BASE_URL=https://api.groq.com/openai/v1        LLM_MODEL=llama-3.3-70b-versatile
#   Ollama   -> LLM_BASE_URL=http://localhost:11434/v1             LLM_MODEL=llama3.1
#   OpenAI   -> LLM_BASE_URL=https://api.openai.com/v1             LLM_MODEL=gpt-4o-mini

# --- Limites de segurança --------------------------------------------------
MAX_CONCURRENT_TASKS=3
STEP_TIMEOUT_MS=25000
TASK_TIMEOUT_S=600
MAX_STEPS_PER_TASK=5

# Chave-mestra do cofre de senhas (opcional). Se vazia, gera uma em data/secrets/master.key
# ORBE_MASTER_KEY=troque-por-algo-forte
